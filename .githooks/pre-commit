#!/bin/sh
#
# Grocery Scanner pre-commit checks. No dependencies on purpose — adding an npm
# hook runner would mean adding npm packages, which is what we're guarding.
#
# Enable (once, after `git init`):
#     git config core.hooksPath .githooks
#
# Bypass a single commit if you really need to:  git commit --no-verify

set -eu

fail=0
note() { printf '  %s\n' "$1"; }
problem() { printf '\npre-commit: %s\n' "$1"; fail=1; }

# Staged files, added/copied/modified only (not deletions).
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# ---------------------------------------------------------------------------
# 1. Never commit credentials or signing material.
# ---------------------------------------------------------------------------
secret_files=$(printf '%s\n' "$staged" | grep -Ei \
  '(^|/)\.env($|\.)|\.(pem|key|p8|p12|jks|keystore|mobileprovision)$' || true)
if [ -n "$secret_files" ]; then
  problem "refusing to commit credential / signing files:"
  printf '%s\n' "$secret_files" | while read -r f; do note "$f"; done
fi

# ---------------------------------------------------------------------------
# 2. Scan staged content for key-shaped strings.
#    .githooks/ is skipped: the patterns below would match themselves.
# ---------------------------------------------------------------------------
patterns='AKIA[0-9A-Z]{16}'
patterns="$patterns|sk-ant-[A-Za-z0-9_-]{16,}"
patterns="$patterns|gh[pousr]_[A-Za-z0-9]{20,}"
patterns="$patterns|github_pat_[A-Za-z0-9_]{20,}"
patterns="$patterns|-----BEGIN [A-Z ]*PRIVATE KEY-----"
patterns="$patterns|(api[_-]?key|secret|password|auth[_-]?token)[\"' ]*[:=][\"' ]*[A-Za-z0-9_/+-]{16,}"

for f in $staged; do
  case "$f" in
    .githooks/*|pnpm-lock.yaml) continue ;;
  esac
  [ -f "$f" ] || continue
  if git show ":$f" | grep -nEi "$patterns" >/dev/null 2>&1; then
    problem "possible secret in $f:"
    git show ":$f" | grep -nEi "$patterns" | head -3 | while read -r l; do
      note "$(printf '%.100s' "$l")"
    done
  fi
done

# ---------------------------------------------------------------------------
# 3. Dependency hygiene.
# ---------------------------------------------------------------------------
if printf '%s\n' "$staged" | grep -q '^node_modules/'; then
  problem "node_modules/ is staged — it belongs in .gitignore."
fi

pkg=$(printf '%s\n' "$staged" | grep -c '^package\.json$' || true)
lock=$(printf '%s\n' "$staged" | grep -cE '^(package-lock\.json|pnpm-lock\.yaml)$' || true)

# Only a change to the DEPENDENCY fields needs the lockfile alongside it.
# Comparing the whole file would flag a script or a jest setting too, and a
# check that cries wolf on an unrelated edit is one people learn to skip with
# --no-verify — which is worse than the false positive it was avoiding.
#
# Prints "changed" when the dependency fields differ from HEAD, nothing when
# they match. Falls back to treating any package.json edit as a dependency edit
# if node is unavailable or the file cannot be parsed, so a broken parse fails
# closed rather than silently waving a real change through.
deps_changed() {
  command -v node >/dev/null 2>&1 || { echo changed; return; }
  git show HEAD:package.json >/dev/null 2>&1 || { echo changed; return; }

  fields='["dependencies","devDependencies","optionalDependencies","peerDependencies","resolutions","overrides","pnpm","packageManager","engines"]'
  git show :package.json > "$tmp/staged.json" 2>/dev/null || { echo changed; return; }
  git show HEAD:package.json > "$tmp/head.json" 2>/dev/null || { echo changed; return; }

  node -e '
    const fs = require("fs");
    const fields = JSON.parse(process.argv[3]);
    const pick = (f) => {
      const o = JSON.parse(fs.readFileSync(f, "utf8"));
      return JSON.stringify(fields.map((k) => [k, o[k] ?? null]));
    };
    try {
      if (pick(process.argv[1]) !== pick(process.argv[2])) console.log("changed");
    } catch { console.log("changed"); }
  ' "$tmp/staged.json" "$tmp/head.json" "$fields" 2>/dev/null || echo changed
}

if [ "$pkg" -gt 0 ] && [ "$lock" -eq 0 ]; then
  if [ -n "$(deps_changed)" ]; then
    problem "package.json dependencies changed but the lockfile didn't."
    note "Commit them together so the locked tree stays reproducible."
    note "See AGENTS.md for the 7-day dependency cooldown before adding packages."
  fi
fi

# ---------------------------------------------------------------------------
# 3b. Never allow a git/tarball dependency. pnpm blocks build scripts by
#     default (strictDepBuilds), but it won't stop you sourcing a package from
#     git — and registry tarballs skip their `prepare` script while git deps
#     run it. Every entry must resolve to an integrity hash.
# ---------------------------------------------------------------------------
if [ "$lock" -gt 0 ] && [ -f pnpm-lock.yaml ]; then
  if grep -nE "resolution: \{(repo|tarball|directory):" pnpm-lock.yaml >/dev/null; then
    problem "non-registry dependency in pnpm-lock.yaml:"
    grep -nE "resolution: \{(repo|tarball|directory):" pnpm-lock.yaml |
      head -5 | while read -r l; do note "$l"; done
  fi
fi

# ---------------------------------------------------------------------------
# 4. Oversized files (the lockfile is legitimately large, so allow it).
# ---------------------------------------------------------------------------
for f in $staged; do
  [ "$f" = "pnpm-lock.yaml" ] && continue
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -gt 1048576 ]; then
    problem "$f is $((size / 1024))KB — over the 1MB limit."
  fi
done

# ---------------------------------------------------------------------------
# 5. Lint and format the staged files. Reports only — it never rewrites your
#    files mid-commit. Self-skips until Biome is installed.
#    Fix with:  pnpm run lint:fix
# ---------------------------------------------------------------------------
if [ -x node_modules/.bin/biome ]; then
  if ! out=$(node_modules/.bin/biome check --staged --no-errors-on-unmatched 2>&1); then
    problem "Biome found issues in the staged files:"
    printf '%s\n' "$out" | head -25 | while read -r l; do note "$l"; done
    note "Fix with: pnpm run lint:fix"
  fi
fi

# ---------------------------------------------------------------------------
# 6. Run the tests that cover the staged files.
#    Only the related ones, so this stays fast. Skipped entirely when jest
#    isn't installed, so a fresh clone can still commit. For a deliberate
#    work-in-progress commit:  SKIP_TESTS=1 git commit
# ---------------------------------------------------------------------------
js_staged=$(printf '%s\n' "$staged" | grep -E '\.jsx?$' || true)
if [ -n "$js_staged" ] && [ -z "${SKIP_TESTS:-}" ] && [ -x node_modules/.bin/jest ]; then
  # shellcheck disable=SC2086
  if ! out=$(node_modules/.bin/jest --bail --passWithNoTests --silent \
               --findRelatedTests $js_staged 2>&1); then
    problem "tests covering the staged files failed:"
    printf '%s\n' "$out" | tail -15 | while read -r l; do note "$l"; done
    note "Re-run in full with: pnpm test"
  fi
fi

if [ "$fail" -ne 0 ]; then
  printf '\nCommit aborted. Fix the above, or use --no-verify to override.\n\n'
  exit 1
fi

exit 0
