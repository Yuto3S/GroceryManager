{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The whole codebase is TypeScript. Note this only stops tsc from *reading*
    // JS — a stray .js file would be skipped silently, not flagged, because
    // Metro would still happily bundle it. The "no-js" script is what actually
    // enforces the migration; see package.json.
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  // `.expo/types` holds the route map Expo Router generates from the app/
  // directory when `experiments.typedRoutes` is on — it is what makes a typo in
  // an href a compile error. tsconfig glob patterns skip dot-directories, so it
  // has to be listed explicitly; `**/*.ts` does not reach it.
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
